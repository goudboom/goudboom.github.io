---
// One Inspiratiebank card. Each form (vorm) has its own visual style.
// Long texts are clamped so cards in a row stay calm; the item page shows everything.
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { categories, forms } from '../content/taxonomy';
import { itemDescription } from '../lib/inspiration';

interface Props {
  item: CollectionEntry<'inspiratie'>;
  headingLevel?: 'h2' | 'h3';
}

const { item, headingLevel = 'h3' } = Astro.props;
// Plain Markdown items show in full; rich MDX mini-pages show a short summary on the card.
const isRich = item.filePath?.endsWith('.mdx') ?? false;
const { Content } = await render(item);
const { titel, categorie, vorm, bron, afbeelding, afbeeldingAlt } = item.data;
const Heading = headingLevel;
const url = `/inspiratiebank/${item.id}/`;
---

<article class:list={['ins-card', `ins-card--${vorm}`]} data-vorm={vorm} data-categorie={categorie}>
  {
    afbeelding && (
      <Image class="ins-card__image" src={afbeelding} alt={afbeeldingAlt ?? ''} width={640} loading="lazy" />
    )
  }
  <p class="ins-card__meta">
    <span class="ins-card__form">{forms[vorm]}</span>
    <span aria-hidden="true">·</span>
    <span>{categories[categorie]}</span>
  </p>
  <Heading class="ins-card__title"><a href={url}>{titel}</a></Heading>
  <div class="ins-card__body">
    {isRich ? <p>{itemDescription(item)}</p> : vorm === 'quote' ? <blockquote><Content /></blockquote> : <Content />}
  </div>
  <div class="ins-card__foot">
    {bron ? <p class="ins-card__source">— {bron}</p> : <span />}
    <svg class="ins-card__arrow" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square">
      <path d="M3 12h17M14 6l6 6-6 6"></path>
    </svg>
  </div>
</article>

<style>
  .ins-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    height: 100%;
    padding: var(--s-5);
    background: var(--c-white);
    border: var(--border);
    transition: border-color var(--dur) var(--ease);
  }

  .ins-card:hover {
    border-color: var(--c-navy);
  }

  .ins-card:focus-within {
    outline: 3px solid var(--c-focus);
    outline-offset: 3px;
  }

  .ins-card :global(.ins-card__image) {
    width: calc(100% + 2 * var(--s-5));
    max-width: none;
    margin: calc(-1 * var(--s-5)) calc(-1 * var(--s-5)) var(--s-2);
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .ins-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--c-ink-muted);
  }

  .ins-card__form {
    font-weight: var(--w-bold);
    color: var(--c-ink);
  }

  .ins-card__title {
    font-size: var(--fs-l);
    line-height: var(--lh-snug);
  }

  .ins-card__title a {
    text-decoration: none;
  }

  .ins-card__title a:focus-visible {
    outline: none;
  }

  /* Whole card clickable */
  .ins-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* Clamp long texts; the item page shows everything */
  .ins-card__body {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 6;
    line-clamp: 6;
    overflow: hidden;
  }

  .ins-card__body :global(p + p) {
    margin-top: var(--s-3);
  }

  .ins-card__body :global(ol) {
    margin: 0;
    padding-left: 1.25rem;
  }

  .ins-card__body :global(ol li::marker) {
    font-weight: var(--w-bold);
  }

  .ins-card__foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s-3);
    margin-top: auto;
    padding-top: var(--s-2);
  }

  .ins-card__source {
    font-size: var(--fs-s);
    color: var(--c-ink-muted);
  }

  .ins-card__arrow {
    flex-shrink: 0;
    width: 1.1rem;
    height: 1.1rem;
    color: var(--c-ink-muted);
    transition: transform var(--dur) var(--ease), color var(--dur) var(--ease);
  }

  .ins-card:hover .ins-card__arrow {
    transform: translateX(3px);
    color: var(--c-ink);
  }

  /* ---------- Per form ---------- */

  /* Gedachte: quiet, gold rule on the left */
  .ins-card--gedachte {
    border-left: var(--rule-gold);
  }

  /* Vraag: navy card, the question is the hero, a gold question mark as a wink */
  .ins-card--vraag {
    overflow: hidden;
    background: var(--c-navy);
    border-color: var(--c-navy);
    color: var(--c-on-navy);
  }

  .ins-card--vraag::after {
    content: '?';
    position: absolute;
    right: 0.12em;
    bottom: -0.1em;
    font-size: 7rem;
    font-weight: var(--w-bold);
    line-height: 1;
    color: var(--c-gold);
    opacity: 0.9;
    pointer-events: none;
  }

  .ins-card--vraag .ins-card__meta,
  .ins-card--vraag .ins-card__form,
  .ins-card--vraag .ins-card__arrow {
    color: var(--c-on-navy-muted);
  }

  .ins-card--vraag .ins-card__body {
    padding-right: 3.5rem;
    font-size: var(--fs-l);
    font-weight: var(--w-bold);
    line-height: var(--lh-snug);
  }

  .ins-card--vraag .ins-card__arrow {
    visibility: hidden;
  }

  .ins-card--vraag:focus-within {
    outline-color: var(--c-gold);
  }

  /* Quote: hanging gold quotation mark next to the text */
  .ins-card--quote blockquote {
    position: relative;
    margin: 0;
    padding-left: 1.6rem;
    font-size: var(--fs-l);
    line-height: 1.45;
  }

  .ins-card--quote blockquote::before {
    content: '“';
    position: absolute;
    left: -0.1rem;
    top: -0.3rem;
    font-size: 3rem;
    font-weight: var(--w-bold);
    line-height: 1;
    color: var(--c-gold);
  }

  .ins-card--quote blockquote :global(p) {
    margin: 0;
  }

  .ins-card--quote .ins-card__source {
    padding-left: 1.6rem;
  }

  /* Model: surface with numbered steps */
  .ins-card--model {
    background: var(--c-surface);
  }

  /* Tip: soft gold surface */
  .ins-card--tip {
    background: var(--c-gold-soft);
    border-color: var(--c-gold);
  }
</style>
