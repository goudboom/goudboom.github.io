---
// The 9-vlaksmodel (Rijken) as a real table, styled as a diagram. One cell is highlighted.
interface Props {
  title: string;
  caption: string;
  columns: string[];
  rows: { level: string; cells: string[] }[];
  highlight?: string;
}

const { title, caption, columns, rows, highlight } = Astro.props;
---

<figure class="nine">
  <figcaption class="nine__caption">
    <h3 class="nine__title">{title}</h3>
    <p>{caption}</p>
  </figcaption>
  <div class="nine__scroll" tabindex="0" role="region" aria-label={title}>
    <table class="nine__table">
      <thead>
        <tr>
          <td></td>
          {columns.map((column) => <th scope="col">{column}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr>
              <th scope="row">{row.level}</th>
              {row.cells.map((cell) => (
                <td class:list={{ 'is-highlight': cell === highlight }}>{cell}</td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</figure>

<style>
  .nine {
    display: grid;
    gap: var(--s-5);
  }

  .nine__caption {
    display: grid;
    gap: var(--s-2);
    max-width: var(--measure);
  }

  .nine__title {
    font-size: var(--fs-xl);
  }

  .nine__caption p {
    font-size: var(--fs-s);
    color: var(--c-ink-muted);
  }

  .nine__scroll {
    overflow-x: auto;
  }

  .nine__table {
    width: 100%;
    min-width: 30rem;
    border-collapse: separate;
    border-spacing: 4px;
    font-size: var(--fs-s);
    table-layout: fixed;
  }

  .nine__table th,
  .nine__table td {
    padding: var(--s-4) var(--s-3);
    text-align: center;
    vertical-align: middle;
  }

  .nine__table thead th {
    padding-bottom: var(--s-2);
    font-weight: var(--w-bold);
    color: var(--c-ink-muted);
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .nine__table tbody th {
    width: 7.5rem;
    text-align: left;
    font-weight: var(--w-bold);
    color: var(--c-ink-muted);
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .nine__table tbody td {
    background: var(--c-white);
    border: var(--border);
    min-height: 4rem;
  }

  .nine__table tbody td.is-highlight {
    background: var(--c-navy);
    border-color: var(--c-navy);
    color: var(--c-white);
    font-weight: var(--w-bold);
    box-shadow: inset 0 -4px 0 var(--c-gold);
  }
</style>
