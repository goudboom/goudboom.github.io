---
import { Picture } from 'astro:assets';
import Arrow from '../Arrow.astro';
import portrait from '../../assets/foto/yuri-portret.jpg';
import { t, href, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const section = t(lang).home.vision;
---

<section class="section" aria-labelledby="vision-title">
  <div class="container vision">
    <figure class="vision__photo">
      <Picture
        src={portrait}
        alt={section.portraitAlt}
        formats={['avif', 'webp']}
        widths={[320, 480, 640, 900]}
        width={900}
        sizes="(min-width: 68rem) 26rem, (min-width: 48rem) 40vw, calc(100vw - 2rem)"
        loading="lazy"
        decoding="async"
      />
    </figure>
    <div class="vision__content">
      <h2 id="vision-title">{section.title}</h2>
      <dl class="vision__list">
        {
          section.items.map((item) => (
            <div class="vision__item">
              <dt>{item.term}</dt>
              <dd>{item.text}</dd>
            </div>
          ))
        }
      </dl>
      <a class="vision__more" href={`${href('contact', lang)}#overmij`}>
        {section.more}
        <Arrow />
      </a>
    </div>
  </div>
</section>

<style>
  .vision {
    display: grid;
    gap: var(--s-7);
  }

  .vision__photo {
    position: relative;
    max-width: 26rem;
  }

  .vision__photo :global(img) {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
  }

  .vision__content {
    display: grid;
    align-content: start;
    gap: var(--s-6);
  }

  .vision__list {
    display: grid;
    gap: var(--s-5);
  }

  .vision__item {
    display: grid;
    gap: var(--s-2);
    padding-top: var(--s-4);
    border-top: var(--border);
  }

  .vision__item dt {
    font-size: var(--fs-l);
    font-weight: var(--w-bold);
  }

  .vision__item dd {
    margin: 0;
    max-width: var(--measure);
    color: var(--c-ink-muted);
  }

  .vision__more {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    justify-self: start;
    min-height: 2.75rem;
    font-weight: var(--w-bold);
  }

  @media (min-width: 48rem) {
    .vision {
      grid-template-columns: 5fr 7fr;
      align-items: start;
      gap: var(--s-8);
    }
  }
</style>
