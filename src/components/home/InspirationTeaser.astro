---
// Home: an invitation to the Inspiratiebank without cards — one playful action.
// The random button opens a random item page; without JS it goes to the overview.
import Arrow from '../Arrow.astro';
import RandomInspirationButton from '../RandomInspirationButton.astro';
import { t, href, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t(lang);
const section = ui.home.inspiration;
---

<section class="section section--surface" aria-labelledby="inspiration-title">
  <div class="container teaser">
    <div class="teaser__intro">
      <h2 id="inspiration-title">{section.title}</h2>
      <p class="lead">{section.text}</p>
    </div>
    <div class="teaser__action">
      <RandomInspirationButton label={ui.inspiration.randomButton} />
      <p class="teaser__micro">{ui.inspiration.randomMicrocopy}</p>
      <a class="teaser__link" href={href('inspiration', 'nl')}>
        {ui.inspiration.toOverview}
        <Arrow />
      </a>
    </div>
  </div>
</section>

<style>
  .teaser {
    display: grid;
    gap: var(--s-6);
  }

  .teaser__intro {
    display: grid;
    gap: var(--s-4);
    max-width: 40rem;
  }

  .teaser__action {
    display: grid;
    justify-items: start;
    align-content: center;
    gap: var(--s-3);
    padding-left: var(--s-5);
    border-left: var(--rule-gold);
  }

  .teaser__micro {
    font-size: var(--fs-s);
    color: var(--c-ink-muted);
  }

  .teaser__link {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 2.75rem;
    margin-top: var(--s-2);
    font-weight: var(--w-bold);
  }

  @media (min-width: 56rem) {
    .teaser {
      grid-template-columns: 3fr 2fr;
      align-items: center;
      gap: var(--s-8);
    }
  }
</style>
