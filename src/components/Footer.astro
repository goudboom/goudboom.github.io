---
import logo from '../assets/logo/logo-donker-naast-tekst.svg';
import { site, emailHref } from '../site.config';
import { t, href, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <img class="site-footer__logo" src={logo.src} width="270" height="36" alt="" loading="lazy" />
    <ul class="site-footer__list">
      <li>{site.name}</li>
      <li>{ui.footer.kvkLabel} {site.kvk}</li>
      <li><a href={emailHref}>{site.email}</a></li>
      <li><a href={site.phoneHref}>{site.phoneDisplay}</a></li>
      <li><a href={site.linkedin} rel="me noopener" target="_blank">{ui.footer.linkedin}</a></li>
      <li><a href={href('privacy', lang)}>{ui.footer.privacy}</a></li>
    </ul>
    <p class="site-footer__copy">© <span data-year>{year}</span></p>
  </div>
</footer>

<script is:inline>
  // The year is set at build time; this keeps it current between deploys.
  document.querySelectorAll('[data-year]').forEach((el) => (el.textContent = new Date().getFullYear()));
</script>

<style>
  .site-footer {
    background: var(--c-surface);
    color: var(--c-ink-muted);
    border-top: var(--rule-gold);
    padding-block: var(--s-7);
    font-size: var(--fs-s);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--s-5);
  }

  .site-footer__logo {
    width: auto;
    height: 1.75rem;
  }

  .site-footer__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-4);
    list-style: none;
    padding: 0;
  }

  .site-footer__list li {
    display: flex;
    align-items: center;
  }

  .site-footer__list li + li::before {
    content: '·';
    margin-right: var(--s-4);
    color: var(--c-ink-muted);
    font-weight: var(--w-bold);
  }

  .site-footer a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--c-ink);
  }

  .site-footer__copy {
    font-size: var(--fs-xs);
  }

  @media (min-width: 68rem) {
    .site-footer__inner {
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: var(--s-4) var(--s-7);
    }
    .site-footer__list {
      justify-content: flex-end;
    }
    .site-footer__copy {
      grid-column: 1 / -1;
    }
  }
</style>
