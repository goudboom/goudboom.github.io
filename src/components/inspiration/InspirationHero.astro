---
// Heading block shared by the overview and category pages.
import Breadcrumbs from '../Breadcrumbs.astro';

interface Props {
  title: string;
  intro: string;
  crumbs: { name: string; url: string }[];
}

const { title, intro, crumbs } = Astro.props;
---

<header class="ins-hero">
  <Breadcrumbs lang="nl" items={crumbs} />
  <h1>{title}</h1>
  <p class="lead">{intro}</p>
</header>

<style>
  .ins-hero {
    display: grid;
    gap: var(--s-4);
    max-width: 44rem;
    margin-bottom: var(--s-7);
  }

  .ins-hero h1 {
    margin-top: var(--s-4);
  }
</style>
