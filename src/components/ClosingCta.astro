---
// Closing call to action on a navy band: heading + lunch and call buttons.
import Button from './Button.astro';
import { site, lunchMailto } from '../site.config';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
}

const { lang, title } = Astro.props;
const ui = t(lang);
---

<section class="section section--navy on-navy closing" aria-labelledby="closing-title">
  <div class="container closing__inner">
    <h2 id="closing-title" class="closing__title">{title}</h2>
    <div class="closing__actions">
      <Button href={lunchMailto(ui.cta.lunchSubject, ui.cta.lunchBody)}>{ui.cta.lunch}</Button>
      <Button href={site.phoneHref} variant="secondary" onNavy>{ui.cta.call}</Button>
    </div>
  </div>
</section>

<style>
  .closing__inner {
    display: grid;
    gap: var(--s-6);
  }

  .closing__title {
    max-width: 20ch;
    font-size: var(--fs-2xl);
  }

  .closing__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  @media (min-width: 56rem) {
    .closing__inner {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }
</style>
