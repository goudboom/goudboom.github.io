---
// Fixed bottom bar on phones: call + plan lunch. Hidden from 48rem up.
import { site, lunchMailto } from '../site.config';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const ui = t(Astro.props.lang);
---

<div class="callbar">
  <a class="callbar__btn callbar__btn--call" href={site.phoneHref}>
    <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" />
    </svg>
    {ui.cta.call}
  </a>
  <a class="callbar__btn callbar__btn--lunch" href={lunchMailto(ui.cta.lunchSubject, ui.cta.lunchBody)}>
    {ui.cta.lunchShort}
  </a>
</div>

<style>
  .callbar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 60;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-2);
    padding: var(--s-2) var(--s-3) calc(var(--s-2) + env(safe-area-inset-bottom));
    background: var(--c-navy);
  }

  .callbar__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    min-height: 3rem;
    border-radius: var(--radius);
    font-size: var(--fs-s);
    font-weight: var(--w-bold);
    text-decoration: none;
  }

  .callbar__btn--call {
    color: var(--c-white);
    border: 2px solid var(--c-on-navy-muted);
  }

  .callbar__btn--lunch {
    background: var(--c-gold);
    color: var(--c-navy);
  }

  .callbar__btn:focus-visible {
    outline-color: var(--c-gold);
  }

  /* Keep page content clear of the bar */
  :global(body) {
    padding-bottom: calc(var(--callbar-h) + env(safe-area-inset-bottom));
  }

  @media (min-width: 48rem) {
    .callbar {
      display: none;
    }
    :global(body) {
      padding-bottom: 0;
    }
  }
</style>
