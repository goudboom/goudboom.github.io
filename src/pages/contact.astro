---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import yuriSuit from '../assets/foto/yuri-pak.jpg';
import dogs from '../assets/foto/honden-schotland.jpg';
import skye from '../assets/foto/wandelen-skye.jpg';
import { site, lunchMailto, emailHref } from '../site.config';
import { t } from '../i18n';
import { organizationNode, personNode } from '../lib/schema';

const lang = 'nl';
const ui = t(lang);
const page = ui.contact;
const about = page.about;

const jsonLd = [
  organizationNode(),
  personNode(),
  {
    '@type': 'ContactPage',
    '@id': `${site.url}/contact/#page`,
    url: `${site.url}/contact/`,
    name: page.seo.title,
    about: { '@id': `${site.url}/#organization` },
    mainEntity: { '@id': `${site.url}/#yuri` },
  },
];
---

<BaseLayout title={page.seo.title} description={page.seo.description} lang={lang} routeKey="contact" jsonLd={jsonLd}>
  <section class="contact-hero">
    <div class="container contact-hero__grid">
      <div class="contact-hero__main">
        <h1>{page.hero.title}</h1>
        <p class="lead">{page.hero.text}</p>
        <div class="contact-hero__actions">
          <Button href={lunchMailto(ui.cta.lunchSubject, ui.cta.lunchBody)}>{ui.cta.lunch}</Button>
          <Button href={site.phoneHref} variant="secondary">{`${page.hero.callPrefix} ${site.phoneDisplay}`}</Button>
          <Button href={emailHref} variant="secondary">{`${page.hero.mailPrefix} ${site.email}`}</Button>
        </div>
      </div>
      <address class="contact-card">
        <ul>
          <li><strong>{site.name}</strong></li>
          <li>{ui.footer.kvkLabel} {site.kvk}</li>
          <li><a href={emailHref}>{site.email}</a></li>
          <li><a href={site.phoneHref}>{site.phoneDisplay}</a></li>
          <li>{site.city}</li>
          <li><a href={site.linkedin} rel="me noopener" target="_blank">{ui.footer.linkedin}</a></li>
        </ul>
      </address>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="when-title">
    <div class="container split">
      <h2 id="when-title">{page.when.title}</h2>
      <ol class="when">
        {page.when.items.map((item) => <li>{item}</li>)}
      </ol>
    </div>
  </section>

  <section id="overmij" class="section about" aria-labelledby="about-title">
    <div class="container">
      <div class="about-intro">
        <Picture
          class="about-intro__photo"
          src={yuriSuit}
          alt={about.portraitAlt}
          formats={['avif', 'webp']}
          widths={[320, 480, 720]}
          width={720}
          sizes="(min-width: 48rem) 22rem, calc(100vw - 2rem)"
          loading="lazy"
        />
        <div class="about-intro__text">
          <h2 id="about-title">{about.title}</h2>
          <p class="about-intro__lead">{about.intro}</p>
        </div>
      </div>

      <div class="about-story">
        <article class="story">
          <div class="story__text">
            <h3>{about.fresh.title}</h3>
            {about.fresh.text.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          <Picture
            class="story__photo"
            src={dogs}
            alt={about.fresh.photoAlt}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[400, 640, 900]}
            width={900}
            sizes="(min-width: 56rem) 34rem, calc(100vw - 2rem)"
            loading="lazy"
          />
        </article>

        <article class="story story--flip">
          <div class="story__text">
            <h3>{about.colleague.title}</h3>
            {about.colleague.text.map((paragraph) => <p>{paragraph}</p>)}
            <p>{about.colleague.listIntro}</p>
            <ul class="tri-list story__list">
              {about.colleague.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <Picture
            class="story__photo"
            src={skye}
            alt={about.colleague.photoAlt}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[400, 640, 900]}
            width={900}
            sizes="(min-width: 56rem) 34rem, calc(100vw - 2rem)"
            loading="lazy"
          />
        </article>

        <article class="story story--text">
          <h3>{about.teaching.title}</h3>
          <p>{about.teaching.text}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--navy on-navy" aria-labelledby="why-title">
    <div class="container why">
      <div class="why__name">
        <h2 id="why-title">{about.why.title}</h2>
        <p class="why__text">{about.why.text}</p>
      </div>
      <div class="why__slogan">
        <h3 class="why__slogan-title">{about.slogan.title}</h3>
        <dl class="why__list">
          {
            about.slogan.items.map((item) => (
              <div>
                <dt>{item.term}</dt>
                <dd>{item.text}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="facts-title">
    <div class="container split">
      <h2 id="facts-title">{about.facts.title}</h2>
      <div class="facts">
        <ul class="tri-list facts__list">
          <li>{about.facts.experience}</li>
          <li>
            <span class="facts__label">{about.facts.sectorsLabel}:</span>
            <ul class="tags" aria-label={about.facts.sectorsLabel}>
              {about.facts.sectors.map((sector) => <li>{sector}</li>)}
            </ul>
          </li>
          <li>{about.facts.location}</li>
        </ul>

        <details class="credentials">
          <summary>
            <span class="credentials__title">{about.credentials.title}</span>
            <span class="credentials__icon" aria-hidden="true"></span>
          </summary>
          <div class="credentials__body">
            <p>{about.credentials.intro}</p>
            <h3>{about.credentials.educationTitle}</h3>
            <ul class="credentials__education">
              {
                about.credentials.education.map((item) => (
                  <li>
                    <strong>{item.name}</strong> — {item.school} ({item.years})
                  </li>
                ))
              }
            </ul>
            <h3>{about.credentials.certificationsTitle}</h3>
            <table class="credentials__table">
              <thead>
                <tr>
                  <th scope="col">{about.credentials.fieldLabel}</th>
                  <th scope="col">{about.credentials.certsLabel}</th>
                </tr>
              </thead>
              <tbody>
                {
                  about.credentials.groups.map((group) => (
                    <tr>
                      <th scope="row">{group.field}</th>
                      <td>
                        <ul>
                          {group.items.map((item) => (
                            <li>{item}</li>
                          ))}
                        </ul>
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </details>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .contact-hero {
    padding-block: var(--s-7) var(--section-y);
  }

  .contact-hero__grid {
    display: grid;
    gap: var(--s-7);
  }

  .contact-hero__main {
    display: grid;
    gap: var(--s-5);
  }

  .contact-hero__main .lead {
    max-width: 34rem;
  }

  .contact-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .contact-card {
    align-self: end;
    font-style: normal;
    border-left: var(--rule-gold);
  }

  .contact-card ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .contact-card li {
    padding: var(--s-2) 0 var(--s-2) var(--s-5);
  }

  .contact-card li + li {
    border-top: var(--border);
  }

  .contact-card a {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
  }

  /* ---------- Shared split: heading left, content right ---------- */
  .split {
    display: grid;
    gap: var(--s-6);
  }

  .when {
    display: grid;
    gap: var(--s-5);
    list-style: none;
    counter-reset: when;
    padding: 0;
    font-size: var(--fs-l);
    line-height: 1.45;
  }

  .when li {
    counter-increment: when;
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--s-3);
  }

  .when li::before {
    content: counter(when);
    font-size: var(--fs-xl);
    font-weight: var(--w-bold);
    line-height: 1.1;
    border-top: var(--rule-gold);
    padding-top: var(--s-1);
    text-align: center;
  }

  /* ---------- Over mij ---------- */
  .about-intro {
    display: grid;
    gap: var(--s-6);
    align-items: end;
  }

  .about-intro :global(.about-intro__photo) {
    width: 100%;
    max-width: 22rem;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 25%;
  }

  .about-intro__text {
    display: grid;
    gap: var(--s-4);
  }

  .about-intro__lead {
    max-width: 36rem;
    font-size: var(--fs-xl);
    font-weight: var(--w-bold);
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-tight);
  }

  .about-story {
    display: grid;
    gap: var(--s-8);
    margin-top: var(--s-8);
  }

  .story {
    display: grid;
    gap: var(--s-5);
    align-items: center;
  }

  .story__text {
    display: grid;
    gap: var(--s-4);
    max-width: var(--measure);
  }

  .story :global(.story__photo) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .story__list {
    display: grid;
    gap: var(--s-2);
  }

  .story--text {
    display: grid;
    gap: var(--s-4);
    max-width: var(--measure);
    padding-left: var(--s-5);
    border-left: var(--rule-gold);
  }

  /* ---------- Waarom Goudboom + slogan ---------- */
  .why {
    display: grid;
    gap: var(--s-7);
  }

  .why__name {
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }

  .why__text {
    font-size: var(--fs-l);
    color: var(--c-on-navy-muted);
    max-width: 30rem;
  }

  .why__slogan {
    display: grid;
    gap: var(--s-5);
  }

  .why__slogan-title {
    font-size: var(--fs-xl);
  }

  .why__list {
    display: grid;
    gap: var(--s-5);
  }

  .why__list > div {
    display: grid;
    gap: var(--s-2);
    padding-top: var(--s-4);
    border-top: 1px solid rgb(255 255 255 / 0.18);
  }

  .why__list dt {
    font-size: var(--fs-l);
    font-weight: var(--w-bold);
    color: var(--c-gold);
  }

  .why__list dd {
    margin: 0;
    color: var(--c-on-navy-muted);
  }

  /* ---------- In het kort + certificeringen ---------- */
  .facts {
    display: grid;
    gap: var(--s-7);
  }

  .facts__list {
    display: grid;
    gap: var(--s-4);
    font-size: var(--fs-l);
  }

  .facts__label {
    display: block;
    margin-bottom: var(--s-2);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    list-style: none;
    padding: 0;
  }

  .tags li {
    padding: var(--s-1) var(--s-3);
    border: 1px solid var(--c-navy);
    border-radius: 999px;
    font-size: var(--fs-s);
  }

  .credentials {
    border-top: var(--border);
    border-bottom: var(--border);
  }

  .credentials summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding: var(--s-5) 0;
    cursor: pointer;
    list-style: none;
  }

  .credentials summary::-webkit-details-marker {
    display: none;
  }

  .credentials__title {
    font-size: var(--fs-xl);
    font-weight: var(--w-bold);
  }

  .credentials summary:hover .credentials__title {
    text-decoration: underline;
    text-decoration-color: var(--c-gold);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  .credentials__icon {
    position: relative;
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
  }

  .credentials__icon::before,
  .credentials__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--c-navy);
    transition: transform var(--dur) var(--ease);
  }

  .credentials__icon::after {
    transform: rotate(90deg);
  }

  .credentials[open] .credentials__icon::after {
    transform: rotate(0);
  }

  .credentials__body {
    display: grid;
    gap: var(--s-4);
    padding-bottom: var(--s-6);
  }

  .credentials__body h3 {
    margin-top: var(--s-4);
    font-size: var(--fs-l);
  }

  .credentials__education {
    display: grid;
    gap: var(--s-2);
    padding-left: 1.25rem;
  }

  .credentials__table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-s);
  }

  .credentials__table th,
  .credentials__table td {
    padding: var(--s-3) var(--s-3) var(--s-3) 0;
    text-align: left;
    vertical-align: top;
    border-top: var(--border);
  }

  .credentials__table thead th {
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--c-ink-muted);
  }

  .credentials__table tbody th {
    width: 38%;
  }

  .credentials__table ul {
    display: grid;
    gap: var(--s-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 36rem) {
    .credentials__table thead {
      display: none;
    }
    .credentials__table tr,
    .credentials__table th,
    .credentials__table td {
      display: block;
      width: auto;
    }
    .credentials__table tbody th {
      width: auto;
      padding-bottom: 0;
    }
    .credentials__table td {
      border-top: 0;
    }
  }

  @media (min-width: 48rem) {
    .about-intro {
      grid-template-columns: 22rem 1fr;
      gap: var(--s-8);
    }
  }

  @media (min-width: 56rem) {
    .story {
      grid-template-columns: 1fr 1fr;
      gap: var(--s-8);
    }
    .story--flip :global(.story__photo) {
      order: -1;
    }
    .story--text {
      grid-template-columns: 1fr;
      margin-left: calc(50% + var(--s-4));
    }
  }

  @media (min-width: 68rem) {
    .contact-hero__grid {
      grid-template-columns: 8fr 3fr;
      gap: var(--s-8);
    }
    .split {
      grid-template-columns: 1fr 2fr;
      gap: var(--s-8);
    }
    .why {
      grid-template-columns: 1fr 1.4fr;
      gap: var(--s-8);
    }
  }
</style>
